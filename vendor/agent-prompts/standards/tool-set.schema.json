{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agent-prompts tool set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "mask_version",
    "toolset_sha256",
    "order",
    "tools",
    "masks"
  ],
  "properties": {
    "schema": {
      "const": "agent-toolset/1"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "mask_version": {
      "type": "string",
      "minLength": 1
    },
    "toolset_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "order": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description",
          "input_schema",
          "handler",
          "stability"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "input_schema": {
            "type": "object"
          },
          "handler": {
            "type": "string",
            "minLength": 1
          },
          "stability": {
            "enum": [
              "static",
              "deferred"
            ]
          },
          "wire": {
            "type": "object"
          }
        }
      }
    },
    "masks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roles",
        "deferred"
      ],
      "properties": {
        "roles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "deferred": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deferred_unmatched": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
