{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agent-prompts run journal event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "seq", "at", "kind", "unit", "phase", "action", "result", "evidence"],
  "properties": {
    "schema": {"const": "agent-run-journal/1"},
    "seq": {"type": "integer", "minimum": 1},
    "at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "kind": {
      "enum": ["start", "checkpoint", "action_started", "action_result",
               "action_withheld", "note", "stop", "done"]
    },
    "unit": {"type": "string", "minLength": 1},
    "phase": {
      "enum": ["Plan", "Implement", "Review", "Fix", "Verify", "Push",
               "Ready", "Ready (unverified)", "Done", "HALT"]
    },
    "gate": {"enum": ["pass", "fix", "hold", "halt"]},
    "action": {"type": "string"},
    "result": {"type": "string"},
    "evidence": {"type": "string"},
    "action_id": {"type": "string", "minLength": 1},
    "state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reason": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "checkpoint"}}, "required": ["kind"]},
      "then": {"required": ["gate", "state_sha256"]}
    },
    {
      "if": {"properties": {"kind": {"const": "start"}}, "required": ["kind"]},
      "then": {"properties": {"unit": {"const": "run"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "done"}}, "required": ["kind"]},
      "then": {"properties": {"phase": {"const": "Done"}, "gate": {"const": "pass"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "stop"}}, "required": ["kind"]},
      "then": {"properties": {"phase": {"const": "HALT"}, "gate": {"const": "halt"}},
               "required": ["reason"]}
    }
  ]
}
