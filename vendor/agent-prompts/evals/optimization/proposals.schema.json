{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agent-prompts optimization proposal",
  "description": "One human-gated optimization proposal. The markdown ledger at evals/optimization/proposals.md is the record; this schema is the machine-readable form of one row.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "proposal_id",
    "cycle",
    "source_cases",
    "hypothesis",
    "candidate_change",
    "arm",
    "configurations",
    "human_gate",
    "status",
    "evidence"
  ],
  "properties": {
    "schema": {
      "enum": ["agent-prompts-optimization-proposal/1"]
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^P-[1-9][0-9]*$"
    },
    "cycle": {
      "type": "string",
      "pattern": "^C[1-9][0-9]*$"
    },
    "source_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^FC-[0-9]{2}$"
      }
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "candidate_change": {
      "type": "string",
      "minLength": 1
    },
    "arm": {
      "type": "string",
      "minLength": 1
    },
    "configurations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/configuration"}
    },
    "human_gate": {
      "enum": ["pending", "approved", "rejected"]
    },
    "status": {
      "enum": ["proposed", "rejected", "accepted", "blocked"]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "note": {
      "type": "string"
    }
  },
  "definitions": {
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "executor_model",
        "grader_model",
        "harness",
        "cost_usd",
        "latency_s",
        "tokens_input",
        "tokens_output",
        "current_score",
        "candidate_score",
        "paired_wtl"
      ],
      "properties": {
        "key": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9-]*$"},
        "executor_model": {"type": "string", "minLength": 1},
        "grader_model": {"type": "string", "minLength": 1},
        "harness": {"type": "string", "minLength": 1},
        "cost_usd": {"type": ["number", "null"], "minimum": 0},
        "latency_s": {"type": ["number", "null"], "minimum": 0},
        "tokens_input": {"type": ["integer", "null"], "minimum": 0},
        "tokens_output": {"type": ["integer", "null"], "minimum": 0},
        "current_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "candidate_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "paired_wtl": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["wins", "ties", "losses"],
              "properties": {
                "wins": {"type": "integer", "minimum": 0},
                "ties": {"type": "integer", "minimum": 0},
                "losses": {"type": "integer", "minimum": 0}
              }
            }
          ]
        },
        "truncated_pairs": {"type": "integer", "minimum": 0},
        "note": {"type": "string"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "accepted"}}},
      "then": {"properties": {"human_gate": {"const": "approved"}}}
    },
    {
      "if": {"properties": {"status": {"enum": ["accepted", "rejected"]}}},
      "then": {
        "properties": {
          "configurations": {
            "items": {
              "properties": {
                "current_score": {"type": "number"},
                "candidate_score": {"type": "number"},
                "paired_wtl": {"type": "object"}
              }
            }
          }
        }
      }
    }
  ]
}
