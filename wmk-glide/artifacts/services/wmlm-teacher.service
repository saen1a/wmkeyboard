[Unit]
Description=WMLM German teacher pass (150k, chunked)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/wmlm-de
ExecStart=/bin/bash /root/wmlm-de/run_teacher_chunks.sh
Restart=on-failure
RestartSec=30
TimeoutStopSec=30
# Keep the journal small; the script appends to out/teacher_150k.log itself.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
