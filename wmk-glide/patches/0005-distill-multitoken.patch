+def word_mass(probs, position, padded, lengths):
+    """Probability of every mapped word after one position.
+
+    `probs` is the sentence's [tokens, teacher vocab] matrix. For a word
+    t1..tk whose first token is predicted at `position`, the product is
+    p(t1 | position) * p(t2 | position+1) * ... * p(tk | position+k-1).
+    Rows whose sequence runs past the sentence get zero.
+    """
+    n, max_len = padded.shape
+    mass = torch.ones(n, device=probs.device)
+    for l in range(max_len):
+        active = lengths > l
+        if not bool(active.any()):
+            break
+        pos = position + l
+        if pos >= probs.shape[0]:
+            mass = mass.masked_fill(active, 0.0)
+            break
+        ids = padded[active, l]
+        mass = mass.masked_scatter(active, mass[active] * probs[pos].index_select(0, ids))
+    return mass
+
