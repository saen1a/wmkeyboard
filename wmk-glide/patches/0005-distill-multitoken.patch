+        for i in range(len(lengths)):
+            want = 1.0
+            for l in range(int(lengths[i])):
+                if position + l >= probs.shape[0]:
+                    want = 0.0
+                    break
+                want *= float(probs[position + l, int(padded[i, l])])
+            assert abs(got[i] - want) < 1e-6, (position, i, got[i], want)
+    print("self-test ok: word_mass matches the scalar product")
 
 
