+    /**
+     * The context model's say on a glide's readings, in score space: every
+     * candidate moves by its log-probability against the reference,
+     * [GLIDE_LM_BLEND] engine nats per model nat and at most
+     * [GLIDE_LM_BLEND_CAP]. The reference is the first candidate the model can
+     * read — usually the leader, but a German compound the vocabulary does not
+     * list is scored through its pieces and the leader may still be
+     * unreadable. A word the model cannot read keeps its decoder score, as in
+     * [blendContextModel].
+     *
+     * Pieces cost a forward step each, so only the pool the strip can show is
+     * spelled (8 ordinarily, 16 after a deep search), never the whole walk.
+     * Measured on 2,588 FUTO German swipes with the downloaded German model:
+     * 0.5 / 5.0 took top-1 from 74.15 to 77.40 on the 150k list and 75.70 to
+     * 78.48 with the 441k observed compounds.
+     */
+    private fun blendGlideContextModel(decoded: List<GlideBeam.Candidate>): List<GlideBeam.Candidate> {
+        val model = contextModel ?: return decoded
+        if (decoded.size < 2) return decoded
+        val scored = decoded.take(GLIDE_DEEP_POOL)
+        val scores = model.scoresSpelled(scored.map { it.word.lowercase() })
+        val reference = scores.firstOrNull { it.isFinite() } ?: return decoded
+        var moved = false
+        val shifted = decoded.mapIndexed { i, candidate ->
+            val lp = scores.getOrNull(i)
+            if (lp == null || !lp.isFinite()) return@mapIndexed candidate
+            val shift = (GLIDE_LM_BLEND * (lp - reference)).coerceIn(-GLIDE_LM_BLEND_CAP, GLIDE_LM_BLEND_CAP)
+            if (shift == 0.0) {
+                candidate
+            } else {
+                moved = true
+                GlideBeam.Candidate(candidate.word, candidate.score + shift, candidate.shapeCost, candidate.tier, candidate.ahead)
+            }
+        }
+        if (!moved) return decoded
+        // Stable, so equal scores keep the decoder's order.
+        return shifted.sortedByDescending { it.score }
+    }
