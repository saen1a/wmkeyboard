+    /**
+     * The context model's say on a glide's readings, in score space: every
+     * candidate moves by its log-probability against the decoder's leader,
+     * [GLIDE_LM_BLEND] engine nats per model nat and at most
+     * [GLIDE_LM_BLEND_CAP]. A glide is a guess from the start, so the cap can
+     * be wider than the typing path's [LM_BLEND_CAP]: 3 nats on the FUTO
+     * German pool (n=2,294 with a previous word) took 70.84 -> 80.82, against
+     * 82.13 for an uncapped blend. The corpus bigram stands in for the
+     * downloaded model in that measurement; the shape is the shipped one.
+     *
+     * Silent when there is no model, when it does not know the leader, or
+     * when it knows none of the candidates; a word the model cannot read
+     * keeps its decoder score, as in [blendContextModel].
+     */
+    private fun blendGlideContextModel(decoded: List<GlideBeam.Candidate>): List<GlideBeam.Candidate> {
+        val model = contextModel ?: return decoded
+        if (decoded.size < 2) return decoded
+        val words = decoded.map { it.word }
+        val scores = model.scores(words)
+        val reference = scores.firstOrNull() ?: return decoded
+        if (reference.isNaN()) return decoded
+        var moved = false
+        val shifted = decoded.mapIndexed { i, candidate ->
+            val lp = scores.getOrNull(i) ?: return@mapIndexed candidate
+            if (lp.isNaN()) return@mapIndexed candidate
+            val shift = (GLIDE_LM_BLEND * (lp - reference)).coerceIn(-GLIDE_LM_BLEND_CAP, GLIDE_LM_BLEND_CAP)
+            if (shift == 0.0) {
+                candidate
+            } else {
+                moved = true
+                GlideBeam.Candidate(candidate.word, candidate.score + shift, candidate.shapeCost, candidate.tier, candidate.ahead)
+            }
+        }
+        if (!moved) return decoded
+        // Stable, so equal scores keep the decoder's order.
+        return shifted.sortedByDescending { it.score }
+    }
