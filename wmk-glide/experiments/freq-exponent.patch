+    /// `ln(1 + frequency)` under the configured exponent; exactly the old
+    /// linear term at 1.0, monotonic for every positive exponent so the
+    /// bounds stay upper bounds.
+    fn freq_term(&self, frequency: i32) -> f64 {
+        let x = ln1p(frequency);
+        if self.freq_exponent == 1.0 {
+            x
+        } else {
+            x.powf(self.freq_exponent)
+        }
+    }
