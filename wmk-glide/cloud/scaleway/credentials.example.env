# Copy to C:\Users\saenta\.scw\wmlm-h100.env and fill in.
# Never commit the filled file.
#
# `scw` (2.65.1) reads these from the environment; no ~/.config/scw/config.yaml
# is needed. It requires the Organization ID as well as the Project ID for
# project-scoped calls like `scw instance server list` (verified 30.10.2026).
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
SCW_DEFAULT_PROJECT_ID=
SCW_DEFAULT_ORGANIZATION_ID=
SCW_DEFAULT_ZONE=fr-par-2
SCW_INSTANCE_TYPE=H100-1-80G
SCW_IMAGE_NAME=Ubuntu Noble GPU OS 13 (Nvidia)
SCW_INSTANCE_ID=
SCW_INSTANCE_IP=
SCW_SSH_USER=root
# Generated 29.10.2026, ed25519, no passphrase (scripts use `ssh -i` unattended).
# Public key: C:\Users\saenta\.ssh\wmlm-h100_ed25519.pub
SCW_SSH_KEY_PATH=C:\Users\saenta\.ssh\wmlm-h100_ed25519
MAX_BUDGET_EUR=50
# Optional; Qwen3.8-27B is public.
HF_TOKEN=
